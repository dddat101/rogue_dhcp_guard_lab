# Rogue DHCP guard test configuration
# Copy to config.env and adjust before running.

# Two physical Linux Ethernet interfaces, each cabled to a different DUT LAN port.
ROGUE_IF="enxROGUE"
VICTIM_IF="enxVICTIM"

NS_ATK="ns-atk"
NS_LAN="ns-lan1"

# Rogue DHCP network. Keep this isolated from DUT management/LAN networks.
ROGUE_SERVER_IP="10.10.0.1"
ROGUE_PREFIX="24"
ROGUE_POOL_START="10.10.0.100"
ROGUE_POOL_END="10.10.0.150"
ROGUE_LEASE="5m"

# Expected legitimate DUT DHCP subnet. Used only for validation.
DUT_LAN_CIDR="192.168.1.0/24"
DUT_LAN_IP="192.168.1.1"

# Timing from the implementation under test. Adjust to approved product values.
DETECT_WAIT_SEC="5"
CLEAR_WAIT_SEC="60"
DHCP_ACQUIRE_TIMEOUT_SEC="15"

CAPTURE_DIR="captures"
STATE_DIR="state"

# Independent DUT management path. Do not point this at either test interface.
DUT_SSH_HOST=""
DUT_SSH_USER="root"
DUT_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no"

# Optional DUT commands. Leave empty until mapped to actual platform commands.
DUT_STATUS_CMD=""
DUT_DHCP_STATUS_CMD=""
DUT_GUARD_COUNTER_CMD=""
DUT_CAPTURE_IF="br0"

# Tools
DHCP_CLIENT="udhcpc"
TSHARK_BIN="tshark"
TCPDUMP_BIN="tcpdump"
DNSMASQ_BIN="dnsmasq"
